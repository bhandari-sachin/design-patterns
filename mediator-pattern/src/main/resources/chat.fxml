<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ChatClientController">

    <Label fx:id="titleLabel" text="Chat Client"/>

    <TextArea fx:id="chatArea" editable="false" prefHeight="300"/>

    <HBox spacing="10">
        <TextField fx:id="messageField" promptText="Type message"/>
    </HBox>

    <HBox spacing="10">
        <ComboBox fx:id="recipientBox" promptText="Select recipient"/>
        <Button text="Send" onAction="#sendMessage"/>
    </HBox>

</VBox>